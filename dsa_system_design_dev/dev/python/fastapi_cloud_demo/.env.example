# ---------------------------------------------------------------------------
# FastAPI Cloud Demo — environment configuration
# Copy to .env and adjust. EVERY variable is optional: with none set, the app
# runs fully offline (EchoProvider, no keys, no external services).
# NEVER commit a real .env with secrets.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
API_V1_PREFIX=/api/v1
# Leave empty for open mode; set to require an X-API-Key header.
API_KEY=

# --- Counter feature ---
COUNTER_INTERVAL_SECONDS=1.0
COUNTER_START=0

# --- LLM provider selection: echo | ollama | openai ---
LLM_PROVIDER=echo
LLM_MODEL=echo-1
LLM_TEMPERATURE=0.2

# --- OpenAI-compatible provider (optional) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama provider (optional, local, no cloud key) ---
OLLAMA_BASE_URL=http://localhost:11434
