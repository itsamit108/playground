# ---------------------------------------------------------------------------
# Deep Dive — environment configuration
# Copy to .env and fill in. EVERY variable is optional: with none set, the app
# runs fully offline (EchoProvider + in-memory vector store + offline PDF parser).
# NEVER commit a real .env with secrets.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- API / security ---
API_V1_PREFIX=/api/v1
# Leave empty for open/offline mode; set to require an X-API-Key header.
API_KEY=

# --- LLM provider selection ---
# auto | echo | gemini   (auto -> Gemini when a key is present, else echo)
LLM_PROVIDER=auto
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.2

# --- Google Gemini (google-genai). Either name works; GEMINI takes precedence. ---
GOOGLE_API_KEY=
GEMINI_API_KEY=

# --- Document parsing (LlamaParse / llama-cloud) ---
# Without a key the app uses an offline placeholder parser.
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_TIER=agentic

# --- RAG ---
EMBEDDING_DIM=256
RAG_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Storage ---
OUTPUT_DIR=generated
