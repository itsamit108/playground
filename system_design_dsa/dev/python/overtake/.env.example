# ---------------------------------------------------------------------------
# Overtake — environment configuration
# Copy to .env and adjust. The AI layer runs fully offline by default
# (EchoProvider + in-memory vector store). PostgreSQL + S3 are required only for
# the note/attachment persistence features and are provided by LocalStack.
# NEVER commit a real .env with secrets.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=Overtake
APP_VERSION=0.2.0
LOG_LEVEL=INFO

# --- Database (LocalStack RDS PostgreSQL) ---
# Tests override this with in-memory SQLite automatically.
DATABASE_URL=postgresql://overtake:overtake123@localhost:4510/overtake_db

# --- AWS / S3 (LocalStack) ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=overtake-media

# --- JWT auth ---
JWT_SECRET_KEY=super-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI / LLM provider ---
# echo = offline deterministic default (no key). openai/anthropic = extension points.
LLM_PROVIDER=echo
LLM_MODEL=echo-1
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# --- RAG (assistant over your own notes) ---
EMBEDDING_DIM=256
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=40
RAG_TOP_K=4
