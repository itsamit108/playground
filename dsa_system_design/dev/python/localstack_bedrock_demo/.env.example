# ---------------------------------------------------------------------------
# LocalStack Bedrock GenAI Service — environment configuration
# Copy to .env and adjust. With no config the service runs fully offline
# (EchoProvider). Point it at LocalStack Bedrock to use real Converse calls.
# NEVER commit a real .env with secrets.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Auth (optional API key; no-op when unset) ---
API_KEY=

# --- AWS / LocalStack Bedrock ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- LLM provider selection: auto | bedrock | echo ---
# auto -> use Bedrock when reachable, otherwise fall back to the EchoProvider.
LLM_PROVIDER=auto
BEDROCK_MODEL_ID=ollama.llama3.2
BEDROCK_CONNECT_TIMEOUT=5
SYSTEM_PROMPT=You are a helpful, concise AI assistant. Answer questions clearly and briefly.

# --- Docker Compose only: LocalStack Pro auth token (for Bedrock emulation) ---
LOCALSTACK_AUTH_TOKEN=
